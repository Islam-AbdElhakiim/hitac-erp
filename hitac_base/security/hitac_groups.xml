    <!-- =========================================
         Admin (all privileges + implied access to all users)
    ========================================== -->
    <record id="group_hitac_admin" model="res.groups">
        <field name="name">Hitac Admin</field>
        <field name="privilege_id" ref="privilege_hitac_administration" />
        <!-- base.group_system: needed to actually manage users (create/edit
             res.users, reach Settings > Users & Companies). Does NOT expose
             Apps/Technical/Dashboards/Link Tracker — those stay hard-locked
             to group_sys_admin specifically (menu_overrides.xml), regardless
             of this group. Assigning group_sys_admin itself to a user is
             separately blocked in code (models/res_users.py) unless the
             acting user already holds it. -->
        <field name="implied_ids"
            eval="[
        Command.link(ref('hitac_base.group_hitac_sales_manager')),
        Command.link(ref('hitac_base.group_hitac_supply_manager')),
        Command.link(ref('hitac_base.group_hitac_production_manager')),
        Command.link(ref('hitac_base.group_hitac_logistics_manager')),
        Command.link(ref('base.group_system')),
        Command.link(ref('account.group_account_invoice'))
        ]" />
        <!-- Note: base.group_system natively implies base.group_no_one
             (Odoo's own "Technical Features" toggle) — Hitac Admin gets it
             transitively through group_system regardless of anything set
             here; there's no way to grant group_system without it. Not
             relied on for anything — see menu_overrides.xml, which exposes
             "Groups" directly instead, independent of developer mode. -->
        <!-- Deliberately NOT given any of the per-module "Access Level"
             groups above: an admin who belongs to none of a model's
             Access Level groups is simply not affected by those ir.rule
             records at all (Odoo only evaluates group-scoped rules for
             users who hold one of the referenced groups), so Hitac Admin
             already sees every document unrestricted — same reasoning as
             why it was never added to the native sales_team groups. -->
    </record>

</odoo>
