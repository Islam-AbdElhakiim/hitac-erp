<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =========================================
         Administration (System Admin / Hitac Admin only —
         not tied to a specific business module, so it keeps its own
         standalone section instead of joining the per-module ones below).
    ========================================== -->
    <record id="module_category_hitac" model="ir.module.category">
        <field name="name">Hitac Administration</field>
        <field name="description">Hitac ERP System Administration</field>
        <field name="sequence">1</field>
    </record>

    <record id="privilege_hitac_administration" model="res.groups.privilege">
        <field name="name">Administration</field>
        <field name="category_id" ref="module_category_hitac" />
        <field name="sequence">1</field>
    </record>

    <record id="group_sys_admin" model="res.groups">
        <field name="name">System Admin</field>
        <field name="privilege_id" ref="privilege_hitac_administration" />
        <field name="implied_ids" eval="[Command.set([ref('base.group_system')])]" />
    </record>

    <!-- =========================================
         Per-module categories (Odoo 19: category → privilege → group).
         Each business module gets its own section in the Access Rights
         tab, holding two privileges:
           - "Security Group": the module's User / Manager tier.
           - "Access Level": which records that tier can see/edit,
             enforced via the ir.rule records in each module's own
             security/ir_rules.xml.
    ========================================== -->

    <!-- Sales -->
    <record id="module_category_hitac_sales" model="ir.module.category">
        <field name="name">Hitac Sales</field>
        <field name="description">Hitac Sales access rights</field>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_hitac_sales" model="res.groups.privilege">
        <field name="name">Security Group</field>
        <field name="category_id" ref="module_category_hitac_sales" />
        <field name="sequence">10</field>
    </record>

    <record id="group_hitac_sales_user" model="res.groups">
        <field name="name">Hitac Sales User</field>
        <field name="privilege_id" ref="privilege_hitac_sales" />
    </record>

    <record id="group_hitac_sales_manager" model="res.groups">
        <field name="name">Hitac Sales Manager</field>
        <field name="privilege_id" ref="privilege_hitac_sales" />
        <field name="implied_ids" eval="[Command.link(ref('hitac_base.group_hitac_sales_user'))]" />
    </record>

    <record id="privilege_hitac_sales_access" model="res.groups.privilege">
        <field name="name">Access Level</field>
        <field name="category_id" ref="module_category_hitac_sales" />
        <field name="sequence">20</field>
    </record>

    <record id="group_hitac_sales_access_own" model="res.groups">
        <field name="name">Own Documents Only</field>
        <field name="privilege_id" ref="privilege_hitac_sales_access" />
        <field name="sequence">10</field>
    </record>

    <record id="group_hitac_sales_access_read_all" model="res.groups">
        <field name="name">Own &amp; Others: Read Only</field>
        <field name="privilege_id" ref="privilege_hitac_sales_access" />
        <field name="sequence">20</field>
    </record>

    <record id="group_hitac_sales_access_full" model="res.groups">
        <field name="name">Own &amp; All: Full Access</field>
        <field name="privilege_id" ref="privilege_hitac_sales_access" />
        <field name="sequence">30</field>
    </record>

