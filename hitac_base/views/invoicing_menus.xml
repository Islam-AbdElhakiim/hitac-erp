<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         "Sales" — money owed TO Hitac. Reuses base's own fully-featured
         Customer Invoices action rather than rebuilding it. Credit Notes
         are handled directly from the invoice they reverse, not as a
         separate menu.
    ====================================================== -->
    <menuitem id="menu_hitac_credit" name="Sales" parent="account.menu_finance" sequence="2"/>
    <menuitem id="menu_hitac_credit_invoices" name="Invoices" action="account.action_move_out_invoice" parent="menu_hitac_credit" sequence="1"/>

    <!-- ======================================================
         "Expenses" — money owed BY Hitac, split by the kind of
         vendor/spend rather than base's single "Vendors" bucket. Every
         bucket is opened as a Receipt (in_receipt), not a Bill: there's no
         manual Bill/Receipt toggle in the Hitac expense form, and which
         bucket a document belongs to is driven by hitac_expense_type
         (models/account_move.py), set automatically from the menu it was
         created from. Domains still include in_invoice so pre-existing
         bills (created before this field existed) keep showing up in the
         right bucket.
    ====================================================== -->
    <record id="action_hitac_bills_supplier" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('hitac_expense_type', '=', 'supplier')]</field>
        <field name="context">{'default_move_type': 'in_receipt', 'default_hitac_expense_type': 'supplier'}</field>
    </record>

    <record id="action_hitac_bills_packing_house" model="ir.actions.act_window">
        <field name="name">Packing Houses</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('hitac_expense_type', '=', 'packing_house')]</field>
        <field name="context">{'default_move_type': 'in_receipt', 'default_hitac_expense_type': 'packing_house'}</field>
    </record>

    <record id="action_hitac_bills_packaging" model="ir.actions.act_window">
        <field name="name">Packagings and Equipments</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('hitac_expense_type', '=', 'packaging')]</field>
        <field name="context">{'default_move_type': 'in_receipt', 'default_hitac_expense_type': 'packaging'}</field>
    </record>

    <record id="action_hitac_bills_employee_expenses" model="ir.actions.act_window">
        <field name="name">Employees Expenses</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('hitac_expense_type', '=', 'employee')]</field>
        <field name="context">{'default_move_type': 'in_receipt', 'default_hitac_expense_type': 'employee'}</field>
    </record>

    <!-- Generic catch-all: anything tagged 'other', plus older records not
         yet backfilled with a hitac_expense_type at all. -->
    <record id="action_hitac_bills_expenses" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_receipt')), ('hitac_expense_type', 'not in', ('supplier', 'packing_house', 'packaging', 'employee'))]</field>
        <field name="context">{'default_move_type': 'in_receipt', 'default_hitac_expense_type': 'other'}</field>
    </record>

    <menuitem id="menu_hitac_expenses" name="Expenses" parent="account.menu_finance" sequence="3"/>
    <menuitem id="menu_hitac_expenses_supplier" name="Suppliers" action="action_hitac_bills_supplier" parent="menu_hitac_expenses" sequence="1"/>
    <menuitem id="menu_hitac_expenses_packing_house" name="Packing Houses" action="action_hitac_bills_packing_house" parent="menu_hitac_expenses" sequence="2"/>
    <menuitem id="menu_hitac_expenses_packaging" name="Packagings and Equipments" action="action_hitac_bills_packaging" parent="menu_hitac_expenses" sequence="3"/>
    <menuitem id="menu_hitac_expenses_employee" name="Employees Expenses" action="action_hitac_bills_employee_expenses" parent="menu_hitac_expenses" sequence="4"/>
    <menuitem id="menu_hitac_expenses_generic" name="Expenses" action="action_hitac_bills_expenses" parent="menu_hitac_expenses" sequence="5"/>
    <menuitem id="menu_hitac_expenses_refunds" name="Refunds" action="account.action_move_in_refund_type" parent="menu_hitac_expenses" sequence="6"/>

    <!-- ======================================================
         HIDE: base's own Customers / Vendors buckets — replaced by the
         Credit / Expenses structure above. Restricted rather than
         removed, same as the rest of this file's Admin-only pattern.
    ====================================================== -->
    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('hitac_base.group_sys_admin')])]" />
    </record>
    <record id="account.menu_finance_payables" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('hitac_base.group_sys_admin')])]" />
    </record>

    <!-- ======================================================
         HIDE: Reporting / Configuration — Admin only, same pattern as
         menu_overrides.xml.
    ====================================================== -->
    <record id="account.menu_finance_reports" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('hitac_base.group_sys_admin')])]" />
    </record>
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('hitac_base.group_sys_admin')])]" />
    </record>

</odoo>
