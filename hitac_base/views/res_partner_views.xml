<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_hitac" model="ir.ui.view">
        <field name="name">hitac.res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="hitac_type" placeholder="Select a Type..."/>
            </xpath>
            <!-- Individual/Company is now derived from hitac_type (see _onchange_hitac_type) -->
            <xpath expr="//field[@name='company_type']" position="replace"/>
        </field>
    </record>

</odoo>
