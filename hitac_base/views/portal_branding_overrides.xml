<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         REMOVE: "Powered by Odoo" link at the bottom of the portal
         record sidebar (used by sale orders, invoices, purchase
         orders, etc. — shared across all portal document pages).
    ====================================================== -->
    <template id="portal_record_sidebar_no_branding" inherit_id="portal.portal_record_sidebar">
        <xpath expr="//a[contains(@href,'odoo.com')]/parent::div" position="replace"/>
    </template>

    <!-- ======================================================
         REMOVE: the "Powered by Odoo" brand promotion in the shared
         site-wide footer bar (every portal/frontend page). The
         Copyright line next to it is kept.
    ====================================================== -->
    <template id="frontend_footer_no_branding" inherit_id="web.frontend_layout">
        <xpath expr="//t[@t-call='web.brand_promotion']/parent::div" position="replace"/>
    </template>

    <!-- ======================================================
         LOGIN PAGE: remove "Manage Databases" / "Powered by Odoo"
         (web.login_layout has its own separate footer, not the shared
         one above) and hook the card into login.scss for branding.
    ====================================================== -->
    <template id="login_layout_hitac_branding" inherit_id="web.login_layout">
        <!-- Uses t-attf-class (dynamic), not a plain class attribute, so
             hasclass() can't match it for selection. A parallel static
             class="" attribute doesn't work either — t-attf-class fully
             overwrites it at render time rather than merging — so the
             dynamic expression itself is rewritten instead, appending
             our class to the same original expression text. -->
        <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
            <attribute name="t-attf-class">card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list hitac_login_card</attribute>
        </xpath>
        <xpath expr="//div[hasclass('mt-4')][hasclass('border-top')]" position="replace"/>
        <!-- Hitac emblem instead of the per-database company logo. -->
        <xpath expr="//div[hasclass('text-center')][hasclass('pb-3')][hasclass('border-bottom')]/img" position="replace">
            <img src="/hitac_base/static/img/hitac.png" alt="Hitac" class="hitac_login_logo"/>
        </xpath>
    </template>

</odoo>
