<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_production_batch" model="ir.sequence">
        <field name="name">Production Batch</field>
        <field name="code">production.batch</field>
        <field name="prefix">BATCH/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_stock_pallet" model="ir.sequence">
        <field name="name">Stock Pallet</field>
        <field name="code">stock.pallet</field>
        <field name="prefix">PLT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
