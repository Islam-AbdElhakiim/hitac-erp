<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         List View
    ====================================================== -->
    <record id="view_production_batch_list" model="ir.ui.view">
        <field name="name">production.batch.list</field>
        <field name="model">production.batch</field>
        <field name="arch" type="xml">
            <list string="Production Batches"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="type"/>
                <field name="packing_house_id"/>
                <field name="responsible_id"/>
                <field name="sales_order_id"/>
                <field name="pallet_count" string="Pallets"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ======================================================
         Form View
    ====================================================== -->
    <record id="view_production_batch_form" model="ir.ui.view">
        <field name="name">production.batch.form</field>
        <field name="model">production.batch</field>
        <field name="arch" type="xml">
            <form string="Production Batch">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_reset" string="Reset to Draft" type="object"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pallets" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="pallet_count" widget="statinfo" string="Pallets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="packing_house_id"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="sales_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pallets">
                            <field name="pallet_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="qr_code" readonly="1"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======================================================
         Action
    ====================================================== -->
    <record id="action_production_batch" model="ir.actions.act_window">
        <field name="name">Production Batches</field>
        <field name="res_model">production.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
