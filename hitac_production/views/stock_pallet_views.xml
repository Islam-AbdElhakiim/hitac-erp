<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         List View
    ====================================================== -->
    <record id="view_stock_pallet_list" model="ir.ui.view">
        <field name="name">stock.pallet.list</field>
        <field name="model">stock.pallet</field>
        <field name="arch" type="xml">
            <list string="Pallets">
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="batch_id"/>
                <field name="qr_code"/>
                <field name="status" widget="badge"
                       decoration-muted="status == 'draft'"
                       decoration-info="status == 'ready'"
                       decoration-warning="status == 'loaded'"
                       decoration-success="status == 'shipped'"/>
            </list>
        </field>
    </record>

    <!-- ======================================================
         Form View
    ====================================================== -->
    <record id="view_stock_pallet_form" model="ir.ui.view">
        <field name="name">stock.pallet.form</field>
        <field name="model">stock.pallet</field>
        <field name="arch" type="xml">
            <form string="Pallet">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,ready,loaded,shipped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Product Info">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="batch_id"/>
                        </group>
                        <group string="Loading Info">
                            <field name="position_in_container"/>
                            <field name="loaded_by"/>
                            <field name="loaded_at"/>
                        </group>
                    </group>
                    <group string="Tracking">
                        <field name="qr_code" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======================================================
         Action
    ====================================================== -->
    <record id="action_stock_pallet" model="ir.actions.act_window">
        <field name="name">Pallets</field>
        <field name="res_model">stock.pallet</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
