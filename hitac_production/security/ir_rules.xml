<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Access Level record rules for production.batch and stock.pallet
         (see hitac_base's group_hitac_production_access_own/read_all/full).
         production.batch has a real "Responsible" field (responsible_id);
         stock.pallet has none, so it falls back to create_uid — pallets
         are also reachable from hitac_logistics, whose own Access Level
         rules (security/ir_rules.xml) govern logistics.shipment/
         logistics.container instead of stock.pallet, since ownership of a
         pallet is a production concept, not a logistics one. -->

    <record id="production_batch_hitac_access_own_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own Documents Only</field>
        <field name="model_id" ref="model_production_batch"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_own'))]"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
    </record>

    <record id="production_batch_hitac_access_read_all_read_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own &amp; Others Read Only (read)</field>
        <field name="model_id" ref="model_production_batch"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_read_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="production_batch_hitac_access_read_all_write_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own &amp; Others Read Only (write own)</field>
        <field name="model_id" ref="model_production_batch"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_read_all'))]"/>
        <field name="domain_force">[('responsible_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="production_batch_hitac_access_full_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own &amp; All Full Access</field>
        <field name="model_id" ref="model_production_batch"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_full'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="stock_pallet_hitac_access_own_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own Documents Only</field>
        <field name="model_id" ref="model_stock_pallet"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_own'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="stock_pallet_hitac_access_read_all_read_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own &amp; Others Read Only (read)</field>
        <field name="model_id" ref="model_stock_pallet"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_read_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="stock_pallet_hitac_access_read_all_write_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own &amp; Others Read Only (write own)</field>
        <field name="model_id" ref="model_stock_pallet"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_read_all'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="stock_pallet_hitac_access_full_rule" model="ir.rule">
        <field name="name">Hitac Production Access Level: Own &amp; All Full Access</field>
        <field name="model_id" ref="model_stock_pallet"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_production_access_full'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
