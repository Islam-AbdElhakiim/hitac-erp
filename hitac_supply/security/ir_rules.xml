<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Access Level record rules for supply.order and supply.shipment
         (see hitac_base's group_hitac_supply_access_own/read_all/full).
         Neither model has a dedicated "responsible" field, so ownership
         is keyed off create_uid. -->

    <record id="supply_order_hitac_access_own_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own Documents Only</field>
        <field name="model_id" ref="model_supply_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_own'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="supply_order_hitac_access_read_all_read_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own &amp; Others Read Only (read)</field>
        <field name="model_id" ref="model_supply_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_read_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="supply_order_hitac_access_read_all_write_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own &amp; Others Read Only (write own)</field>
        <field name="model_id" ref="model_supply_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_read_all'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="supply_order_hitac_access_full_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own &amp; All Full Access</field>
        <field name="model_id" ref="model_supply_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_full'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="supply_shipment_hitac_access_own_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own Documents Only</field>
        <field name="model_id" ref="model_supply_shipment"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_own'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="supply_shipment_hitac_access_read_all_read_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own &amp; Others Read Only (read)</field>
        <field name="model_id" ref="model_supply_shipment"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_read_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="supply_shipment_hitac_access_read_all_write_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own &amp; Others Read Only (write own)</field>
        <field name="model_id" ref="model_supply_shipment"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_read_all'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="supply_shipment_hitac_access_full_rule" model="ir.rule">
        <field name="name">Hitac Supply Access Level: Own &amp; All Full Access</field>
        <field name="model_id" ref="model_supply_shipment"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_supply_access_full'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
