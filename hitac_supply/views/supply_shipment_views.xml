<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="supply_shipment_view_list" model="ir.ui.view">
        <field name="name">supply.shipment.list</field>
        <field name="model">supply.shipment</field>
        <field name="arch" type="xml">
            <list string="Supply Shipments"
                  decoration-warning="status == 'shipped'"
                  decoration-success="status == 'received'"
                  decoration-danger="status == 'returned'">
                <field name="supply_order_id"/>
                <field name="is_return"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="destination"/>
                <field name="expected_date"/>
                <field name="quantity"/>
                <field name="received_quantity"/>
                <field name="receiver_user_id"/>
                <field name="status" widget="badge"
                       decoration-muted="status == 'pending'"
                       decoration-warning="status == 'shipped'"
                       decoration-success="status == 'received'"
                       decoration-danger="status == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="supply_shipment_view_form" model="ir.ui.view">
        <field name="name">supply.shipment.form</field>
        <field name="model">supply.shipment</field>
        <field name="arch" type="xml">
            <form string="Supply Shipment">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shipment Info">
                            <field name="supply_order_id"/>
                            <field name="is_return"/>
                            <field name="product_id"/>
                            <field name="supplier_id"/>
                            <field name="destination"/>
                            <field name="expected_date"/>
                        </group>
                        <group string="Receipt">
                            <field name="quantity"/>
                            <field name="received_quantity"/>
                            <field name="receiver_user_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="supply_shipment_view_search" model="ir.ui.view">
        <field name="name">supply.shipment.search</field>
        <field name="model">supply.shipment</field>
        <field name="arch" type="xml">
            <search string="Supply Shipments">
                <field name="supply_order_id"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <separator/>
                <filter string="Return Shipments" name="filter_returns" domain="[('is_return', '=', True)]"/>
                <separator/>
                <filter string="Pending" name="filter_pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Shipped" name="filter_shipped" domain="[('status', '=', 'shipped')]"/>
                <filter string="Received" name="filter_received" domain="[('status', '=', 'received')]"/>
                <filter string="Returned" name="filter_returned" domain="[('status', '=', 'returned')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Supplier" name="group_supplier" context="{'group_by': 'supplier_id'}"/>
                    <filter string="Supply Order" name="group_supply_order" context="{'group_by': 'supply_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supply_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">supply.shipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="supply_shipment_view_search"/>
    </record>

</odoo>
