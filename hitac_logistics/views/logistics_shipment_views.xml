<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         List View
    ====================================================== -->
    <record id="view_logistics_shipment_list" model="ir.ui.view">
        <field name="name">logistics.shipment.list</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <list string="Shipments"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'in_transit'"
                  decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="departure_date"/>
                <field name="arrival_date"/>
                <field name="container_count" string="Containers"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ======================================================
         Form View
    ====================================================== -->
    <record id="view_logistics_shipment_form" model="ir.ui.view">
        <field name="name">logistics.shipment.form</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_transit" string="Set In Transit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_deliver" string="Mark Delivered" type="object"
                            class="btn-primary" invisible="state != 'in_transit'"/>
                    <button name="action_reset" string="Reset to Draft" type="object"
                            invisible="state != 'in_transit'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_transit,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_containers" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="container_count" widget="statinfo" string="Containers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="departure_date"/>
                        </group>
                        <group>
                            <field name="arrival_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Containers">
                            <field name="container_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="pallet_count" string="Pallets"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======================================================
         Action
    ====================================================== -->
    <record id="action_logistics_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">logistics.shipment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
