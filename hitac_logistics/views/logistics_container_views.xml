<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================================================
         List View
    ====================================================== -->
    <record id="view_logistics_container_list" model="ir.ui.view">
        <field name="name">logistics.container.list</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <list string="Containers"
                  decoration-info="state == 'open'"
                  decoration-warning="state == 'sealed'"
                  decoration-success="state == 'shipped'">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="pallet_count" string="Pallets"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ======================================================
         Form View
    ====================================================== -->
    <record id="view_logistics_container_form" model="ir.ui.view">
        <field name="name">logistics.container.form</field>
        <field name="model">logistics.container</field>
        <field name="arch" type="xml">
            <form string="Container">
                <header>
                    <button name="action_load_pallets" string="Load Pallets" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_seal" string="Seal Container" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_ship" string="Mark Shipped" type="object"
                            invisible="state != 'sealed'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'sealed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,sealed,shipped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pallets" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="pallet_count" widget="statinfo" string="Pallets"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="shipment_id"/>
                    </group>
                    <notebook>
                        <page string="Pallets">
                            <field name="pallet_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="position_in_container"/>
                                    <field name="loaded_by"/>
                                    <field name="loaded_at"/>
                                    <field name="status" widget="badge"/>
                                    <button name="action_unload" string="Unload" type="object"
                                            icon="fa-times" invisible="status != 'loaded'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======================================================
         Action
    ====================================================== -->
    <record id="action_logistics_container" model="ir.actions.act_window">
        <field name="name">Containers</field>
        <field name="res_model">logistics.container</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
