#: code:addons/hitac_sales/models/sale_order.py:0
msgid "Only a Confirmed order can move to Supply."
msgstr "يمكن فقط للطلب المؤكد الانتقال إلى مرحلة التوريد."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid "Only a Departed order can be reset to Shipping."
msgstr "يمكن فقط إعادة الطلب الذي تم شحنه إلى مرحلة الشحن."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid "Only a Paid order can be reset to Departed."
msgstr "يمكن فقط إعادة الطلب المدفوع إلى حالة \"تم الشحن\"."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid "Only a Production order can be reset to Supply."
msgstr "يمكن فقط إعادة الطلب الذي في مرحلة الإنتاج إلى مرحلة التوريد."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid "Only a Quotation can be sent as a Pro-forma."
msgstr "يمكن فقط إرسال عرض السعر كفاتورة مبدئية."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid ""
"Only a Quotation, Pro-forma, Confirmed, or Cancelled order can be reset."
msgstr ""
"يمكن فقط إعادة الطلب الذي في حالة عرض السعر أو الفاتورة المبدئية أو مؤكد أو "
"ملغي."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid "Only a Shipping order can be reset to Production."
msgstr "يمكن فقط إعادة الطلب الذي في مرحلة الشحن إلى مرحلة الإنتاج."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid ""
"Only a Supply order, or a Production order that did not go through Supply, "
"can be reset to Confirmed."
msgstr ""
"يمكن فقط إعادة طلب في مرحلة التوريد، أو طلب في مرحلة الإنتاج لم يمر بمرحلة "
"التوريد، إلى مرحلة مؤكد."

#. module: hitac_sales
#. odoo-python
#: code:addons/hitac_sales/models/sale_order.py:0
msgid ""
"Only orders that have not yet Departed or been Paid can be cancelled. Use "
"one of the \"Reset to...\" buttons to step back through the pipeline first."
msgstr ""
"لا يمكن إلغاء إلا الطلبات التي لم يتم شحنها أو دفعها بعد. استخدم أحد أزرار "
