<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Modeled on base's sale.email_template_edi_sale, with the
             report swapped to hitac's own branded document and the dead
             state in ('draft', 'sent') check replaced with hitac's actual
             'quotation' state (see _find_mail_template override). -->
        <record id="email_template_hitac_quotation" model="mail.template">
            <field name="name">Hitac Sales: Send Quotation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Quotation (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Used to send a Hitac quotation to the customer</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Your quotation <span style="font-weight: bold;" t-out="object.name or ''"></span>
        amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span> is ready for review.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('hitac_sales.action_report_hitac_saleorder'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Modeled on base's sale.email_template_proforma, same report swap. -->
        <record id="email_template_hitac_proforma" model="mail.template">
            <field name="name">Hitac Sales: Send Pro-forma</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Pro-forma Invoice (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Used to send a Hitac pro-forma invoice to the customer</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Your Pro-forma invoice <span style="font-weight: bold;" t-out="object.name or ''"></span>
        amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span> is available.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('hitac_sales.action_report_hitac_saleorder'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
