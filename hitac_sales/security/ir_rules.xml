<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Access Level record rules for sale.order (see hitac_base's
         group_hitac_sales_access_own/read_all/full, set on the user's
         Sales section in Settings > Users). A user with none of these
         three groups (e.g. Hitac Admin) is unaffected by any of them and
         sees every order, unrestricted. -->

    <record id="sale_order_hitac_access_own_rule" model="ir.rule">
        <field name="name">Hitac Sales Access Level: Own Documents Only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_sales_access_own'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- "Read Only" tier is split into two rules because a single ir.rule
         domain applies to whichever operations it's flagged for: one rule
         lifts the restriction for read, the other keeps write/create/
         unlink restricted to the salesperson's own orders. -->
    <record id="sale_order_hitac_access_read_all_read_rule" model="ir.rule">
        <field name="name">Hitac Sales Access Level: Own &amp; Others Read Only (read)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_sales_access_read_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="sale_order_hitac_access_read_all_write_rule" model="ir.rule">
        <field name="name">Hitac Sales Access Level: Own &amp; Others Read Only (write own)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_sales_access_read_all'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="sale_order_hitac_access_full_rule" model="ir.rule">
        <field name="name">Hitac Sales Access Level: Own &amp; All Full Access</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[Command.link(ref('hitac_base.group_hitac_sales_access_full'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
